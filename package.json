{
  "name": "opendox-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build crates/opendox-wasm --target web --profile wasm-release",
    "build": "npm run build:wasm && npm run build -w @opendox/editor",
    "serve": "node scripts/serve.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:images": "node scripts/e2e-images.mjs",
    "sync-server": "cargo run -p opendox-server --release --",
    "e2e:collab": "node scripts/e2e-collab.mjs"
  }
}
